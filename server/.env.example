# Copy to .env and fill in. .env is not committed.
DATABASE_URL="postgresql://kaytia:change-me@localhost:5432/kaytia?schema=public"
# Server secret for PIN fingerprints: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it private. Changing it invalidates every staff PIN (they would need to be set again).
AUTH_SECRET=""
PORT=4000
# Lets other terminals send tickets to the printers. Without it, only this computer can print.
# Enter the same value in Back Office > Settings > Printers on each terminal.
PRINT_KEY=""

# Mail account for sending purchase orders to suppliers. Leave SMTP_HOST empty to turn it off.
# 465 uses SSL, 587 uses STARTTLS. Gmail needs an app password, not the normal one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Stores <stores@example.com>"

# Cloud copies of hotels' data (Settings > Database sync on each hotel's main computer).
# One site:key pair per hotel, keys of 16 or more random characters. Leave empty to turn it off.
CLOUD_SYNC_KEYS=""
CLOUD_DATA_DIR="cloud-data"
